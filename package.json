{
  "name": "regex-stream-transform",
  "version": "0.1.0",
  "description": "Incremental regex replacement with exact literal emission",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\"",
    "prepublishOnly": "npm run build",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "stream",
    "transform",
    "regex",
    "replace",
    "ai-sdk",
    "streaming"
  ],
  "license": "MIT",
  "peerDependencies": {
    "ai": "^5.0.116"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "ai": "5.0.116",
    "typescript": "5.9.3",
    "prettier": "3.7.4",
    "eslint": "9.39.2",
    "@eslint/js": "9.39.2",
    "typescript-eslint": "8.50.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.26.1+sha512.664074abc367d2c9324fdc18037097ce0a8f126034160f709928e9e9f95d98714347044e5c3164d65bd5da6c59c6be362b107546292a8eecb7999196e5ce58fa"
}
